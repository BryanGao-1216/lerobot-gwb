{
  "video_backend": "pyav",
  "return_uint8": true,
  "use_imagenet_stats": false,
  "image_transforms": {
    "enable": false
  },
  "eval_split": 0.005,
  "tolerance_s": 0.0001,
  "datasets": {
    "libero": {
      "repo_id": "libero_only",
      "root": "/gaowenbin/datasets/libero",
      "weight": 1.0,
      "use_relative_actions": false,
      "image_augmentation": true,
      "gripper_representation": {
        "type": "discrete",
        "open": -1,
        "close": 1
      },
      "action_fields": [
        {
          "key": "action"
        }
      ],
      "state_fields": [
        {
          "key": "observation.state"
        }
      ],
      "camera_fields": {
        "observation.images.base_0_rgb": "observation.images.image",
        "observation.images.left_wrist_0_rgb": "observation.images.image2",
        "observation.images.right_wrist_0_rgb": null
      },
      "lam_camera_key": "observation.images.image"
    }
  }
}
